<Window x:Class="RS232ools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RS232ools"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="RS232ools" Height="860" Width="920"
        MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="{StaticResource BrandBg}">
    <shell:WindowChrome.WindowChrome>
        <!-- Borderless window that keeps Aero snap, resize and a drop shadow.
             CaptionHeight matches the custom title bar so dragging works; the
             window-control buttons opt back into hit-testing individually. -->
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BrandSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat title-bar caption button. Hover colour comes from each button's
             Tag, so the same template serves the minimise/maximise (subtle) and
             close (red) buttons. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Tag" Value="{StaticResource BrandSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource BrandMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBg}"/>
        </Style>

        <!-- Dropdown options. The default popup background is light, so give the
             items an explicit light background and dark text; without this the
             option text has no contrast and is effectively invisible. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrandBg}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark, branded tab headers (the default theme is light). -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Background="Transparent" Padding="16,8" Margin="0,0,4,0"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="{StaticResource BrandSurface}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tab" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Custom title bar -->
            <RowDefinition Height="*"/>      <!-- App content -->
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Height="44" Background="{StaticResource BrandBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App identity (also the draggable region) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#x1F50C;" FontSize="18" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="RS232ools" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandText}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="serial terminal" FontSize="12" Foreground="{StaticResource BrandMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click" ToolTip="Minimise">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click" ToolTip="Maximise">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="Close">
                    <Button.Tag>
                        <SolidColorBrush Color="#E81123"/>
                    </Button.Tag>
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App content -->
        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Connection settings -->
                <RowDefinition Height="Auto"/>   <!-- Status bar -->
                <RowDefinition Height="*"/>      <!-- Receive / send area -->
                <RowDefinition Height="Auto"/>   <!-- About link -->
            </Grid.RowDefinitions>

            <!-- Connection settings -->
            <Border Grid.Row="0" Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Port" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PortCombo" Width="100"
                                  DropDownOpened="PortCombo_DropDownOpened"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Baud" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="BaudCombo" Width="90"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="Data bits" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="DataBitsCombo" Width="70"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="6">
                        <TextBlock Text="Parity" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ParityCombo" Width="90"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="8">
                        <TextBlock Text="Stop bits" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="StopBitsCombo" Width="80"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="10">
                        <TextBlock Text="Handshake" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="HandshakeCombo" Width="120"/>
                    </StackPanel>

                    <Button x:Name="ConnectButton" Grid.Row="0" Grid.Column="12" Content="Connect"
                            Background="{StaticResource BrandAccent}" VerticalAlignment="Bottom"
                            MinWidth="100" Click="ConnectButton_Click"/>
                    <Button x:Name="DisconnectButton" Grid.Row="0" Grid.Column="14" Content="Disconnect"
                            VerticalAlignment="Bottom" MinWidth="100" IsEnabled="False"
                            Click="DisconnectButton_Click"/>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource BrandMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="{StaticResource BrandText}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Working area: Terminal + Simulator tabs -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,8,0,0">

            <!-- Terminal: free-form send / receive -->
            <TabItem Header="Terminal">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Receive header + controls -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Terminal" Foreground="{StaticResource BrandText}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Display" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DisplayModeCombo" Grid.Column="4" Width="180" VerticalAlignment="Center"
                              SelectionChanged="DisplayModeCombo_SelectionChanged"/>
                    <CheckBox x:Name="AutoScrollCheck" Grid.Column="6" Content="Auto-scroll" IsChecked="True"
                              VerticalAlignment="Center"/>
                    <CheckBox x:Name="LogCheck" Grid.Column="8" Content="Log to file" VerticalAlignment="Center"
                              Checked="LogCheck_Checked" Unchecked="LogCheck_Unchecked"/>
                    <Button x:Name="ClearButton" Grid.Column="10" Content="Clear" MinWidth="70"
                            Click="ClearButton_Click"/>
                </Grid>

                <!-- Terminal view (coloured TX/RX in monitor mode) -->
                <Border Grid.Row="1" Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="2">
                    <RichTextBox x:Name="TerminalBox" IsReadOnly="True" Background="Transparent"
                                 Foreground="{StaticResource BrandText}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Send row -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SendBox" Grid.Column="0" Background="{StaticResource BrandSurface}"
                             Foreground="{StaticResource BrandText}" CaretBrush="{StaticResource BrandText}"
                             BorderThickness="0" Padding="8,7" FontFamily="Consolas" FontSize="13"
                             VerticalContentAlignment="Center"
                             KeyDown="SendBox_KeyDown"/>
                    <ComboBox x:Name="LineEndingCombo" Grid.Column="2" Width="120" VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"/>
                    <Button x:Name="SendButton" Grid.Column="4" Content="Send" Background="{StaticResource BrandAccent}"
                            MinWidth="90" Click="SendButton_Click" IsEnabled="False"/>
                </Grid>

                <!-- File send row -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ChooseFileButton" Grid.Column="0" Content="Choose file…" MinWidth="110"
                            Click="ChooseFileButton_Click"/>
                    <TextBlock x:Name="FilePathText" Grid.Column="2" Text="No file selected"
                               Foreground="{StaticResource BrandMuted}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="SendFileButton" Grid.Column="4" Content="Send file" MinWidth="90"
                            Click="SendFileButton_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
            </TabItem>

            <!-- Simulator: generate & parse customisable CSV / NMEA strings -->
            <TabItem Header="Simulator">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="SimScroll">
            <Grid Margin="0,10,2,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- format controls -->
                    <RowDefinition Height="Auto"/>   <!-- fields header -->
                    <RowDefinition Height="130"/>    <!-- fields grid -->
                    <RowDefinition Height="Auto"/>   <!-- generate / stream -->
                    <RowDefinition Height="Auto"/>   <!-- preview -->
                    <RowDefinition Height="Auto"/>   <!-- parse header -->
                    <RowDefinition Height="Auto"/>   <!-- parsed table -->
                </Grid.RowDefinitions>

                <!-- Format controls + save/load -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Format" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SimFormatCombo" Width="90" VerticalAlignment="Center"
                                  SelectionChanged="SimFormatCombo_SelectionChanged"/>
                        <TextBlock Text="Delimiter" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                        <TextBox x:Name="SimDelimiterBox" Width="46" Text="," VerticalContentAlignment="Center"
                                 Padding="4,3" VerticalAlignment="Center" TextChanged="SimDelimiter_TextChanged"/>
                        <CheckBox x:Name="SimChecksumCheck" Content="NMEA checksum" IsChecked="True" Margin="18,0,0,0"
                                  VerticalAlignment="Center" Checked="SimChecksum_Changed" Unchecked="SimChecksum_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="SimSaveConfigButton" Content="Save config…" MinWidth="100"
                            Click="SimSaveConfig_Click"/>
                    <Button Grid.Column="4" x:Name="SimLoadConfigButton" Content="Load config…" MinWidth="100"
                            Click="SimLoadConfig_Click"/>
                </Grid>

                <!-- Fields header + add/remove -->
                <Grid Grid.Row="1" Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fields" Foreground="{StaticResource BrandText}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="SimAddFieldButton" Content="Add field" MinWidth="90"
                            Click="SimAddField_Click"/>
                    <Button Grid.Column="4" x:Name="SimRemoveFieldButton" Content="Remove" MinWidth="80"
                            Click="SimRemoveField_Click"/>
                </Grid>

                <!-- Field definitions -->
                <DataGrid x:Name="SimFieldsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          FontSize="12" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridComboBoxColumn x:Name="SimFieldTypeColumn" Header="Type"
                                                SelectedItemBinding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="55"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="55"/>
                        <DataGridTextColumn Header="Prec" Binding="{Binding Precision}" Width="45"/>
                        <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="55"/>
                        <DataGridTextColumn Header="Fixed text" Binding="{Binding FixedValue}" Width="*"/>
                        <DataGridTextColumn Header="Time format" Binding="{Binding TimestampFormat}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Generate / stream controls -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="SimGenerateSendButton" Content="Generate &amp; send"
                            Background="{StaticResource BrandAccent}" MinWidth="130"
                            Click="SimGenerateSend_Click" IsEnabled="False"/>
                    <Button Grid.Column="2" x:Name="SimPreviewButton" Content="Preview" MinWidth="90"
                            Click="SimPreview_Click"/>
                    <CheckBox Grid.Column="4" x:Name="SimStreamCheck" Content="Stream every"
                              VerticalAlignment="Center" IsEnabled="False"
                              Checked="SimStream_Changed" Unchecked="SimStream_Changed"/>
                    <TextBox Grid.Column="6" x:Name="SimIntervalBox" Width="64" Text="1000"
                             VerticalContentAlignment="Center" Padding="4,3" VerticalAlignment="Center"
                             TextChanged="SimInterval_Changed"/>
                    <TextBlock Grid.Column="8" Text="ms" Foreground="{StaticResource BrandText}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Preview + sent count -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SimPreviewBox" IsReadOnly="True"
                             Background="{StaticResource BrandSurface}" Foreground="{StaticResource BrandText}"
                             BorderThickness="0" Padding="8,6" FontFamily="Consolas" FontSize="13"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="SimSentCountText" Text="0 sent"
                               Foreground="{StaticResource BrandMuted}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>

                <!-- Parse header -->
                <Grid Grid.Row="5" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="SimParseCheck" Content="Parse incoming into table"
                              VerticalAlignment="Center" Checked="SimParse_Changed" Unchecked="SimParse_Changed"/>
                    <Button Grid.Column="2" x:Name="SimClearTableButton" Content="Clear table" MinWidth="90"
                            Click="SimClearTable_Click"/>
                </Grid>

                <!-- Parsed-into-table view -->
                <DataGrid x:Name="SimParsedGrid" Grid.Row="6" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" FontSize="12" RowHeight="22"
                          Height="220"/>
            </Grid>
            </ScrollViewer>
            </TabItem>

            </TabControl>

            <!-- About link -->
            <TextBlock Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Hyperlink Foreground="{StaticResource BrandAccent}" TextDecorations="None"
                           Click="AboutLink_Click">About</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
