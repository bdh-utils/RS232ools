<Window x:Class="RS232ools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RS232ools"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="RS232ools" Height="860" Width="920"
        MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="{StaticResource BrandBg}">
    <shell:WindowChrome.WindowChrome>
        <!-- Borderless window that keeps Aero snap, resize and a drop shadow.
             CaptionHeight matches the custom title bar so dragging works; the
             window-control buttons opt back into hit-testing individually. -->
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Custom title bar -->
            <RowDefinition Height="*"/>      <!-- App content -->
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Height="44" Background="{StaticResource BrandBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App identity (also the draggable region) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#x1F50C;" FontSize="18" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="RS232ools" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandText}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="serial terminal" FontSize="12" Foreground="{StaticResource BrandMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- New session tab -->
                <Button x:Name="NewTabButton" FontSize="12" Margin="20,0,0,0" Padding="10,5"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="NewTabButton_Click" ToolTip="Open another COM port in a new tab">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="New tab" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click" ToolTip="Minimise">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click" ToolTip="Maximise">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="Close">
                    <Button.Tag>
                        <SolidColorBrush Color="#E81123"/>
                    </Button.Tag>
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App content -->
        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>      <!-- Session tabs -->
                <RowDefinition Height="Auto"/>   <!-- About link -->
            </Grid.RowDefinitions>

            <!-- One tab per serial session (COM port + Terminal/Simulator tools) -->
            <TabControl x:Name="SessionTabs" Grid.Row="0" Background="Transparent"
                        BorderThickness="0" Padding="0,8,0,0"/>

            <!-- About link -->
            <TextBlock Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Hyperlink Foreground="{StaticResource BrandAccent}" TextDecorations="None"
                           Click="AboutLink_Click">About</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
